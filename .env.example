# All services remain on IPv4 loopback.
WEIQI_HOST=127.0.0.1
WEIQI_PORT=8010
WEIQI_DATA_DIR=./data

# Quality-first teacher/player provider. OPENAI_API_KEY is also recognized.
WEIQI_OPENAI_API_KEY=
WEIQI_OPENAI_BASE_URL=https://api.openai.com/v1
WEIQI_OPENAI_MODEL=gpt-5.6-sol
WEIQI_OPENAI_REASONING_EFFORT=medium

# Existing sibling LocalLLM gateway. The browser never receives this key.
WEIQI_LOCALLLM_BASE_URL=http://127.0.0.1:8008/v1
WEIQI_OLLAMA_BASE_URL=http://127.0.0.1:11434/api
WEIQI_LOCALLLM_API_KEY=local-dev-key
WEIQI_COACH_MODEL=localllm-balanced
WEIQI_VISION_MODEL=localllm-vision
# Keep local prose off until the selected model passes your factual Weiqi eval.
# Bounded legal-candidate selection remains available regardless of this flag.
WEIQI_LOCALLLM_PROSE_COACHING_ENABLED=false

# Project-local KataGo installed by scripts/setup-katago.sh.
WEIQI_KATAGO_ENABLED=true
WEIQI_KATAGO_GPU=1
WEIQI_KATAGO_MAX_VISITS=500
WEIQI_KATAGO_IDLE_SECONDS=180

# Dedicated visible test desktop (all listeners remain loopback-only).
WEIQI_NOVNC_DISPLAY_NUMBER=101
WEIQI_NOVNC_VNC_PORT=5931
WEIQI_NOVNC_PORT=6131
WEIQI_NOVNC_CDP_PORT=9471
